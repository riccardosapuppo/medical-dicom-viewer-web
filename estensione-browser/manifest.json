{
  "manifest_version": 3,
  "name": "Medical DICOM Viewer - finestre su piu monitor",
  "version": "1.0",
  "description": "Apre e ripristina le finestre del visualizzatore sui monitor della postazione.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "windows",
    "webNavigation",
    "scripting",
    "system.display"
  ],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["*://*/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
